    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;600&family=Inter:wght@300;400;600;700&display=swap');
        
        body {
            /* Anti-Copy & Screenshot Deterrent CSS */
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            
            background-color: #030712; /* Deep slate / black */
            color: #e2e8f0;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            line-height: 1.6;
        }
        
        .font-mono { font-family: 'Fira Code', monospace; }
        
        /* Obfuscate content if printed */
        @media print { body { display: none !important; } }
        
        /* Tech Grid Background */
        .bg-grid {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(6, 182, 212, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(6, 182, 212, 0.03) 1px, transparent 1px);
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1;
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: rgba(17, 24, 39, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(6, 182, 212, 0.15);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
            border-radius: 12px;
            transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }
        .glass-card:hover {
            transform: translateY(-3px);
            border-color: rgba(6, 182, 212, 0.4);
            box-shadow: 0 10px 40px rgba(6, 182, 212, 0.1);
        }

        /* Neon Accents */
        .text-neon {
            color: #06b6d4;
            text-shadow: 0 0 12px rgba(6, 182, 212, 0.5);
        }
        
        .border-neon {
            border-color: #06b6d4;
            box-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #030712; }
        ::-webkit-scrollbar-thumb { background: #06b6d4; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #0891b2; }

        /* Timeline CSS */
        .timeline-container { position: relative; padding-left: 2rem; margin-top: 1.5rem; }
        .timeline-line {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(to bottom, #06b6d4, rgba(6, 182, 212, 0.1));
        }
        .timeline-dot {
            position: absolute;
            left: -5px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #030712;
            border: 2px solid #06b6d4;
            box-shadow: 0 0 10px #06b6d4;
            margin-top: 6px;
        }
        .timeline-item { margin-bottom: 2.5rem; position: relative; }
        
        /* Typewriter Animation */
        .typewriter h1 {
            overflow: hidden;
            border-right: .15em solid #06b6d4;
            white-space: nowrap;
            margin: 0 auto;
            letter-spacing: .05em;
            animation: typing 2.5s steps(30, end), blink-caret .75s step-end infinite;
        }
        @keyframes typing { from { width: 0 } to { width: 100% } }
        @keyframes blink-caret { from, to { border-color: transparent } 50% { border-color: #06b6d4; } }

    </style>
</head>
